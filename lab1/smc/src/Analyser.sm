%class Analyser
%header Analyser.h
%start AnalyserMap::Start

%map AnalyserMap
%%
Start{
    letter(n: char) NameState   {boof(n);}
    EOS             Error       {setBad();}

}

NameState{
    letter(n: char) nil         {boof(n);}
    space           SpaceState  {}
}

SpaceState{
    hyphen  HyphenState {}
    letter(n: char) ArgState    {}
    space           nil         {}
}

Space2State{
    letter(n: char) ArgState    {}
    space nil {}


}

OptState{
    letter(n: char) nil         {}
    space           SpaceState  {}

}

ArgState{
    letter(n: char) nil          {}
    space           Space2State  {}

}

GoodCom{
    nextString      Start       {countUsesCom();resetBuffer();}
}

Error{
    EOS             Error       {}
    nextString      Start       {resetBuffer();}
    space           Error       {}

}

HyphenState{
    EOS             Error       {setBad();}
    letter(n: char) OptState    {}


}

Default{
    unknown         Error       {setBad();}
    hyphen          Error       {setBad();}
    letter(n: char) Error       {setBad();}
    EOS             GoodCom     {setGood();}
    space           Error       {setBad();}
}
%%
