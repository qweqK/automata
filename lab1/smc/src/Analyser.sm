%class Analyser
%header Analyser.h
%start AnalyserMap::Start

%map AnalyserMap
%%
Start{
    letter(n: char) NameState   {boof(n);}
    EOS             Error       {setBad();}

}

NameState{
    letter(n: char) nil         {boof(n);}
    space           SpaceState  {}
}

SpaceState{
    hyphen[ctxt.isBeforeArg()]  HyphenState {}
    hyphen          Error       {setBad();}
    letter(n: char) ArgState    {setAfterArg();}
    space           nil         {}
}

OptState{
    letter(n: char) nil         {}
    space           SpaceState  {}

}

ArgState{
    letter(n: char) nil         {}
    space           SpaceState  {}

}

GoodCom{
    nextString      Start       {countUsesCom();resetBuffer();resetStateStr();}
}

Error{
    EOS Error {}
    nextString      Start       {resetBuffer();resetStateStr();}
    space           Error       {}

}

HyphenState{
    EOS             Error       {setBad();}
    letter(n: char) OptState    {}


}

Default{
    unknown         Error       {setBad();}
    hyphen          Error       {setBad();}
    letter(n: char) Error       {setBad();}
    EOS             GoodCom     {setGood();}
    space           Error       {setBad();}
}
%%
