%class Analyser
%header Analyser.h
%start AnalyserMap::Start

%map AnalyserMap
%%
Start{
    letter(n: char) NameState {printer('s');boof(n);}

}

NameState{
    letter(n: char) nil {nameDGB();boof(n);}
    space SpaceState {}
}

SpaceState{
    hyphen[ctxt.isBeforeArg()] OptState {increaseOpt();}
    hyphen Error {setBad();}
    letter(n: char) ArgState {increaseArg();setAfterArg();}
    space nil {printer('p');}
}

OptState{
    letter(n: char) nil {printer('o');}
    //number(num: int) NumberState {numCounter(num);}
    //EOS Error{}
    space SpaceState{}

}

ArgState{
    letter(n: char) nil {printer('a');}
    //number NumberState {}
    //EOS Error {}
    space SpaceState {}

}

/*{NumberState{
    number(num: int) nil {numCounter(num);}
    space[ctxt.isNumEqual()] SpaceState {}
    space Error {}
    EOS[ctxt.isNumEqual()] GoodCom {setGood();}
    EOS Error {setBad();}
}*/

GoodCom{
    nextString Start {increaseCom();countUsesCom();resetBuffer();}
}

Error{
    EOS Error {printer('e');}
    nextString Start {printer('e');resetBuffer();}
    space Error {}

}

Default{
    unknown Error {setBad();}
    hyphen Error {setBad();}
    letter(n: char) Error {setBad();}
    EOS GoodCom {setGood();}
}
%%